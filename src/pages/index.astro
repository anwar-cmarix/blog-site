---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()
);
---
<Layout title="Auto Blog">
  <h1>Latest Posts</h1>
  <div class="grid">
    {posts.map((post) => (
      <a href={`/blog/${post.id}/`} class="card">
        <img src={post.data.image} alt={post.data.title} loading="lazy" />
        <div class="body">
          <h2>{post.data.title}</h2>
          <p>{post.data.description}</p>
          <small>{new Date(post.data.pubDate).toLocaleDateString('en-IN', { dateStyle: 'medium' })}</small>
        </div>
      </a>
    ))}
  </div>
</Layout>

<style>
  .grid { display:grid; grid-template-columns:repeat(auto-fill,minmax(280px,1fr)); gap:24px; }
  .card { background:var(--card); border-radius:12px; overflow:hidden; transition:transform .2s; }
  .card:hover { transform:translateY(-4px); }
  .card img { width:100%; height:170px; object-fit:cover; background:#334155; }
  .body { padding:16px; }
  .body h2 { font-size:1.1rem; margin:0 0 8px; }
  .body p { color:var(--muted); font-size:.9rem; margin:0 0 10px; }
  small { color:var(--accent); }
</style>